+// NOTE ON PREFIXES: the embedder applies search_query:/search_document: itself
+// (health reports prefixConvention, and it was verified empirically — embedding
+// "foo" and "search_query: foo" through embed_query yields cosine 0.9952, not
+// 1.0, i.e. the manual prefix is a SECOND prefix). The plugin must therefore
+// send the raw query. Prefixing here would silently degrade every search.
+async function createOnboardQueryEmbedding({ query, settings, timeoutMs }) {
+  if (!settings.endpoint) {
+    return {
+      ok: false,
+      reason:
+        `Embedding provider "${settings.providerLabel}" is onboard, but no endpoint is configured. ` +
+        "Set factory_config embedding_endpoint (category 'embedding') to the embedder's MCP URL, or set OMATIC_EMBEDDER_URL.",
+    };
+  }
+  const called = await onboardMcpCall({
+    endpoint: settings.endpoint,
+    token: settings.token,
+    name: "embed_query",
+    args: { text: query },
+    timeoutMs,
+  });
+  if (!called.ok) return { ok: false, reason: called.reason };
+
+  const structured = called.structured;
+  const vector = structured.vector || (Array.isArray(structured.vectors) ? structured.vectors[0] : null);
+  if (!Array.isArray(vector) || vector.length === 0) {
+    return { ok: false, reason: "Onboard embedder returned no numeric embedding array." };
+  }
+
+  // Both assertions are FATAL, not fallback-worthy. Searching a corpus with a
+  // vector from a different model or a different width does not degrade
+  // gracefully — pgvector either errors on the dimension or, worse, returns
+  // confident nonsense from an unrelated vector space. Refusing is the only
+  // honest answer, which is why the embedder returns weightsIdentifier at all.
+  const reportedDimension = Number(structured.dimension ?? vector.length);
+  if (settings.expectedDimension && reportedDimension !== settings.expectedDimension) {
+    return {
+      ok: false,
+      fatal: true,
+      reason:
+        `Onboard embedder returned ${reportedDimension} dimensions but this factory's corpus is ` +
+        `${settings.expectedDimension}. Refusing to search rather than query a mismatched vector space.`,
+    };
+  }
+  const reportedWeights = structured.weightsIdentifier ? String(structured.weightsIdentifier) : null;
+  if (settings.expectedWeights && reportedWeights && reportedWeights !== settings.expectedWeights) {
+    return {
+      ok: false,
+      fatal: true,
+      reason:
+        `Onboard embedder is running weights "${reportedWeights}" but this factory's corpus was embedded ` +
+        `with "${settings.expectedWeights}". Refusing to search rather than return results from a ` +
+        "different vector space. Re-embed the corpus or point at the matching embedder.",
+    };
+  }
+
+  return {
+    ok: true,
+    vector,
+    model: reportedWeights || settings.model || settings.providerLabel,
+    dimensions: vector.length,
+    source: "onboard",
+  };
+}
