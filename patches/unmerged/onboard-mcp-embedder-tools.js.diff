+// factory_config.value is jsonb. Depending on driver settings a scalar arrives
+// either already-parsed ("nomic…") or as its JSON text ("\"nomic…\""), and the
+// old code path only ever touched keys it String()-ed, so the difference never
+// showed. Reading dimensions and a weights identifier makes it matter: a
+// dimension compared as the string "768" against the number 768 is a false
+// mismatch, and a quoted identifier never equals its unquoted twin.
+function configValue(raw) {
+  if (raw === undefined || raw === null) return null;
+  if (typeof raw === "object") return raw;
+  if (typeof raw === "number" || typeof raw === "boolean") return raw;
+  const text = String(raw).trim();
+  if (!text) return null;
+  const looksJson =
+    (text.startsWith('"') && text.endsWith('"')) || text.startsWith("{") || text.startsWith("[");
+  if (looksJson) {
+    try {
+      return JSON.parse(text);
+    } catch {
+      return text;
+    }
+  }
+  return text;
+}
+
+function configScalar(raw) {
+  const value = configValue(raw);
