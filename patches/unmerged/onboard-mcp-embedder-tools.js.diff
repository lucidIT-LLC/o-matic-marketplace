+// Minimal MCP JSON-RPC client. The onboard embedder exposes tools/call only —
+// it has no OpenAI-compatible REST surface (POST /v1/embeddings and /embeddings
+// both 404), so pointing openai_base_url at it cannot work and the transport
+// has to be spoken properly.
+async function onboardMcpCall({ endpoint, token, name, args, timeoutMs }) {
+  if (typeof fetch !== "function") {
+    return { ok: false, reason: "This Node runtime does not expose fetch; Node 18+ is required." };
+  }
+  const controller = new AbortController();
+  const timer = setTimeout(() => controller.abort(), timeoutMs);
+  try {
+    const headers = {
+      "Content-Type": "application/json",
+      // The server negotiates either; sending both matches the reference client
+      // and avoids a 406 on deployments that stream.
+      Accept: "application/json, text/event-stream",
+    };
+    if (token) headers.Authorization = `Bearer ${token}`;
+    const response = await fetch(endpoint, {
+      method: "POST",
+      headers,
+      body: JSON.stringify({
+        jsonrpc: "2.0",
+        id: 1,
+        method: "tools/call",
+        params: { name, arguments: args },
+      }),
+      signal: controller.signal,
+    });
+    const text = await response.text();
+    let payload = {};
+    try {
+      payload = text ? JSON.parse(text) : {};
+    } catch {
+      return {
+        ok: false,
+        reason: `Onboard embedder returned a non-JSON response (HTTP ${response.status}).`,
+      };
+    }
+    if (!response.ok) {
+      const detail =
+        (payload && payload.error && (payload.error.message || payload.error)) || `HTTP ${response.status}`;
+      // 401/403 is the single most likely misconfiguration here, so it is named
+      // rather than folded into a generic transport failure.
+      const hint =
+        response.status === 401 || response.status === 403
+          ? " The onboard embedder rejected the bearer token — set factory_config embedding_api_key (an env: reference is supported) or OMATIC_EMBEDDER_TOKEN."
+          : "";
+      return { ok: false, reason: `Onboard embedder request failed: ${detail}.${hint}` };
+    }
+    if (payload.error) {
+      const message = payload.error.message || JSON.stringify(payload.error);
+      return { ok: false, reason: `Onboard embedder returned a JSON-RPC error: ${message}` };
+    }
+    const result = payload.result;
+    if (!result) {
+      return { ok: false, reason: "Onboard embedder response contained no result." };
+    }
+    if (result.isError) {
+      return { ok: false, reason: `Onboard embedder tool reported an error: ${JSON.stringify(result)}` };
+    }
+    let structured = result.structuredContent;
+    if (!structured && Array.isArray(result.content) && result.content[0] && result.content[0].text) {
+      try {
+        structured = JSON.parse(result.content[0].text);
+      } catch {
+        return { ok: false, reason: "Onboard embedder content was not parseable JSON." };
+      }
+    }
+    if (!structured) {
+      return { ok: false, reason: "Onboard embedder response contained no structured content." };
+    }
+    return { ok: true, structured };
+  } catch (err) {
+    return {
+      ok: false,
+      reason:
+        err && err.name === "AbortError"
+          ? "Onboard embedder request timed out."
+          : `Onboard embedder request failed: ${err && err.message ? err.message : String(err)}`,
+    };
+  } finally {
+    clearTimeout(timer);
+  }
+}
