{
  "_comment": "Per-plugin version-source map (rule #287). The marketplace catalog entry is CANONICAL; every other source must equal it. Add a source here when a plugin grows a new place that carries its version, or the alignment check will not see it. type=marketplace reads the canonical catalog entry; type=json reads obj[field]; type=regex captures group 1 from the first matching line (case-sensitive). All catalogFiles must agree: the Codex catalog is a real distribution surface, and a version there that disagrees with the canonical entry ships wrong metadata to Codex operators with nothing to catch it.",
  "canonicalType": "marketplace",
  "catalogFiles": [
    "marketplace.json",
    ".claude-plugin/marketplace.json",
    ".agents/plugins/marketplace.json"
  ],
  "plugins": {
    "omatic-server-connection": {
      "runtime": true,
      "sources": [
        {
          "type": "marketplace",
          "label": "catalog (canonical)"
        },
        {
          "type": "json",
          "path": "omatic-server-connection/.claude-plugin/plugin.json",
          "field": "version",
          "label": "plugin.json"
        },
        {
          "type": "json",
          "path": "omatic-server-connection/.codex-plugin/plugin.json",
          "field": "version",
          "label": "codex plugin.json"
        },
        {
          "type": "json",
          "path": "omatic-server-connection/agent-pack.json",
          "field": "version",
          "label": "agent-pack.json"
        },
        {
          "type": "json",
          "path": "omatic-server-connection/package.json",
          "field": "version",
          "label": "package.json"
        },
        {
          "type": "json",
          "path": "omatic-server-connection/server/package.json",
          "field": "version",
          "label": "server/package.json"
        },
        {
          "type": "regex",
          "path": "omatic-server-connection/skills/omatic-server-operating-guide/SKILL.md",
          "pattern": "<!--\\s*version:\\s*([^\\s|]+)",
          "label": "operating-guide SKILL.md header"
        },
        {
          "type": "regex",
          "path": "omatic-server-connection/server/index.js",
          "pattern": "PLUGIN_VERSION\\s*=\\s*[\"']([^\"']+)[\"']",
          "label": "runtime PLUGIN_VERSION (server/index.js)"
        }
      ]
    },
    "o-matic-wordpress-factory": {
      "runtime": true,
      "sources": [
        {
          "type": "marketplace",
          "label": "catalog (canonical)"
        },
        {
          "type": "json",
