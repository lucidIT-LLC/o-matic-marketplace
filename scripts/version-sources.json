          "pattern": "version:\\s*[\"']([^\"']+)[\"']",
          "label": "runtime version (server/index.mjs WP connector)"
        },
        {
          "type": "regex",
          "path": "o-matic-wordpress-factory/server/elementor.mjs",
          "pattern": "version:\\s*[\"']([^\"']+)[\"']",
          "label": "runtime version (server/elementor.mjs Elementor connector)"
        }
      ]
    },
