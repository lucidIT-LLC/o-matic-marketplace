{
  "mcpServers": {
    "omatic-server-connection": {
      "command": "/bin/sh",
      "args": [
        "${PLUGIN_ROOT}/bin/omatic-launch.sh"
      ],
      "env": {
        "OMATIC_PLATFORM": "codex",
        "OMATIC_PROJECT_ROOT": "${CODEX_WORKSPACE}",
        "OMATIC_FACTORY_JSON_PATH": "${CODEX_WORKSPACE}/.omatic/factory.json"
      }
    }
  }
}
